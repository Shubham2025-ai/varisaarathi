generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  WARKARI
  VOLUNTEER
  DOCTOR
  DISPATCHER
  RESPONDER
  ADMIN
}

enum RiskBadge {
  GREEN
  AMBER
  RED
}

enum AlertType {
  MEDICAL
  HEAT_RISK
  SAFETY
  LOST_ELDERLY
  THEFT
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESPONDER_ASSIGNED
  EN_ROUTE
  RESOLVED
}

enum TriggerChannel {
  APP
  SMS
  MISSED_CALL
  VOLUNTEER_SCAN
}

enum ConcernCategory {
  OVERCHARGED_FACILITY
  SANITATION
  WATER_FOOD_QUALITY
  OTHER
}

enum ConcernStatus {
  QUEUED
  IN_REVIEW
  RESOLVED
}

enum CampType {
  MEDICAL
  POLICE
  AMBULANCE_BASE
}

model User {
  id            String    @id @default(cuid())
  role          Role
  name          String
  phone         String    @unique
  email         String?   @unique
  passwordHash  String?
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  warkariProfile WarkariProfile?

  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Dindi {
  id       String  @id @default(cuid())
  name     String
  leaderId String?

  members WarkariProfile[]

  @@index([name])
}

model WarkariProfile {
  id      String  @id @default(cuid())
  userId  String? @unique
  user    User?   @relation(fields: [userId], references: [id])
  dindiId String
  dindi   Dindi   @relation(fields: [dindiId], references: [id])

  name          String
  phone         String
  dob           DateTime
  gender        String
  bloodGroup    String?
  address       String
  aadhaarHash   String?   @unique
  riskBadge     RiskBadge @default(GREEN)
  healthSummary Json
  qrCode        String    @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  alerts   Alert[]
  concerns Concern[]

  @@index([dindiId])
  @@index([phone])
}

model Camp {
  id        String   @id @default(cuid())
  name      String
  type      CampType
  latitude  Float
  longitude Float
  capacity  Int?
  active    Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, active])
  @@index([latitude, longitude])
}

model Alert {
  id        String          @id @default(cuid())
  warkariId String?
  warkari   WarkariProfile? @relation(fields: [warkariId], references: [id])

  type           AlertType
  status         AlertStatus    @default(OPEN)
  triggerChannel TriggerChannel

  latitude       Float?
  longitude      Float?
  locationSource String?

  // NOTE: deliberately NOT a strict foreign key to User. Dispatch
  // suggestions rank Camps (physical locations), but a "responder" in the
  // full design is a person. Mapping camps to on-duty staff is out of
  // scope for the hackathon MVP, so this just stores whichever id the
  // dispatcher confirmed (camp or user) as plain text.
  aiSuggestion        Json?
  assignedResponderId String?

  createdAt      DateTime  @default(now())
  acknowledgedAt DateTime?
  assignedAt     DateTime?
  enRouteAt      DateTime?
  resolvedAt     DateTime?

  @@index([status])
  @@index([type])
  @@index([warkariId])
  @@index([createdAt])
}

model Concern {
  id        String          @id @default(cuid())
  warkariId String?
  warkari   WarkariProfile? @relation(fields: [warkariId], references: [id])

  category    ConcernCategory
  description String?
  photoUrl    String?
  latitude    Float
  longitude   Float
  status      ConcernStatus   @default(QUEUED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([category])
}

model HeatAdvisory {
  id             String   @id @default(cuid())
  routeSegment   String
  heatIndex      Float
  advisoryTextEn String
  advisoryTextMr String
  pushedAt       DateTime @default(now())

  @@index([routeSegment, pushedAt])
}
